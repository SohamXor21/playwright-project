# Copy this file to ".env" (PowerShell: Copy-Item .env.example .env) and adjust.
# .env is git-ignored - never commit real credentials.

BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# Customer account used by login / checkout / API tests.
# The Toolshop login page publishes demo customer accounts for practice use.
USER_EMAIL=
USER_PASSWORD=

# Optional: admin account. Only needed by the API test that deletes a user.
# That test is skipped automatically when these are empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
